@model UpdateSiteSettingDto

@{
    ViewData["Title"] = "Site Ayarları";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["ActiveMenu"] = "settings";
}

<style>
    .admin-card {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 24px;
        box-shadow: 0 1px 3px rgba(0,0,0,.06);
    }

    .admin-card-header {
        border-bottom: 1px solid #f1f5f9;
        padding-bottom: 12px;
        margin-bottom: 20px;
    }

        .admin-card-header h4 {
            margin: 0;
            font-size: 1.1rem;
            color: #2d3748;
        }

        .admin-card-header .theme {
            color: #17a2a2;
            margin-right: 6px;
        }
</style>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success" id="successAlert">@TempData["Success"]</div>
    <script>
        setTimeout(function() {
            var alert = document.getElementById('successAlert');
            if (alert) {
                alert.style.transition = 'opacity 0.5s';
                alert.style.opacity = '0';
                setTimeout(function() { alert.style.display = 'none'; }, 500);
            }
        }, 3000);
    </script>
}

<div class="admin-page-header mb-4">
    <h1 class="page-title">Site Ayarları</h1>
    <p class="text-muted">Video, iletişim bilgileri ve sosyal medya bağlantılarını buradan yönetin.</p>
</div>

<form asp-action="Index" method="post">
    <input type="hidden" asp-for="SiteSettingId" />

    <div class="admin-card mb-4">
        <div class="admin-card-header">
            <h4><i class="bi bi-play-circle theme"></i> Tanıtım Videosu</h4>
        </div>
        <div class="field-group">
            <label asp-for="VideoUrl" class="field-label">YouTube Video Bağlantısı</label>
            <input asp-for="VideoUrl" type="url" class="form-control" placeholder="https://www.youtube.com/watch?v=..." />
            <div class="field-hint">Herhangi bir YouTube bağlantısı yapıştırabilirsiniz; sistem otomatik dönüştürür.</div>
        </div>
    </div>

    <div class="admin-card mb-4">
        <div class="admin-card-header">
            <h4><i class="bi bi-telephone theme"></i> İletişim Bilgileri</h4>
        </div>
        <div class="row">
            <div class="col-md-4 field-group">
                <label asp-for="Phone" class="field-label">Telefon</label>
                <input asp-for="Phone" class="form-control" placeholder="+90 ..." />
            </div>
            <div class="col-md-4 field-group">
                <label asp-for="Email" class="field-label">E-posta</label>
                <input asp-for="Email" type="email" class="form-control" placeholder="ornek@@site.com" />
            </div>
            <div class="col-md-4 field-group">
                <label asp-for="Address" class="field-label">Adres</label>
                <input asp-for="Address" class="form-control" placeholder="Şehir, ülke" />
            </div>
        </div>
    </div>

    <div class="admin-card mb-4">
        <div class="admin-card-header">
            <h4><i class="bi bi-share theme"></i> Sosyal Medya</h4>
        </div>
        <div class="row">
            <div class="col-md-3 field-group">
                <label asp-for="GitHubUrl" class="field-label"><i class="fab fa-github"></i> GitHub</label>
                <input asp-for="GitHubUrl" type="url" class="form-control" placeholder="https://github.com/..." />
            </div>
            <div class="col-md-3 field-group">
                <label asp-for="XUrl" class="field-label"><i class="fab fa-x-twitter"></i> X</label>
                <input asp-for="XUrl" type="url" class="form-control" placeholder="https://x.com/..." />
            </div>
            <div class="col-md-3 field-group">
                <label asp-for="InstagramUrl" class="field-label"><i class="fab fa-instagram"></i> Instagram</label>
                <input asp-for="InstagramUrl" type="url" class="form-control" placeholder="https://instagram.com/..." />
            </div>
            <div class="col-md-3 field-group">
                <label asp-for="LinkedinUrl" class="field-label"><i class="fab fa-linkedin"></i> LinkedIn</label>
                <input asp-for="LinkedinUrl" type="url" class="form-control" placeholder="https://linkedin.com/..." />
            </div>
        </div>
    </div>

    <button type="submit" class="btn btn-primary">Kaydet</button>
</form>
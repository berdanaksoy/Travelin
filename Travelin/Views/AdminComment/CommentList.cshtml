@model List<ResultCommentDto>

@{
    ViewData["Title"] = "Yorumlar";
    ViewData["ActiveMenu"] = "comments";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    string status = ViewBag.Status as string;
    int pendingCount = ViewBag.PendingCount;
}

<div class="page-header">
    <div>
        <h1 class="page-title">Yorumlar</h1>
        <nav aria-label="breadcrumb" class="mt-2">
            <ol class="breadcrumb">
                <li class="breadcrumb-item">Admin</li>
                <li class="breadcrumb-item active">Yorumlar</li>
            </ol>
        </nav>
    </div>
</div>

@if (pendingCount > 0)
{
    <div class="alert alert-warning d-flex align-items-center gap-2" style="border-radius:10px;font-size:.875rem;">
        <i class="bi bi-clock-history"></i>
        <span><strong>@pendingCount</strong> yorum onay bekliyor.</span>
    </div>
}

<div class="form-section">
    <div class="section-body py-3">
        <div class="d-flex gap-2 flex-wrap">
            <a asp-action="CommentList"
               class="btn btn-sm @(string.IsNullOrEmpty(status) ? "btn-primary" : "btn-outline-secondary")"
               style="border-radius:8px;">
                Tümü
            </a>
            <a asp-action="CommentList" asp-route-status="pending"
               class="btn btn-sm @(status == "pending" ? "btn-primary" : "btn-outline-secondary")"
               style="border-radius:8px;">
                Onay Bekleyenler
            </a>
            <a asp-action="CommentList" asp-route-status="approved"
               class="btn btn-sm @(status == "approved" ? "btn-primary" : "btn-outline-secondary")"
               style="border-radius:8px;">
                Onaylananlar
            </a>
        </div>
    </div>
</div>

<div class="table-card">
    <div class="table-card-header">
        <div class="title">
            <i class="bi bi-star" style="color:#a0aec0;"></i>
            Yorum Listesi
            <span class="record-count">@Model.Count yorum</span>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="empty-state">
            <i class="bi bi-chat-square-text"></i>
            <p>Gösterilecek yorum bulunamadı.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Yorum Sahibi</th>
                        <th>Tur</th>
                        <th>Puan</th>
                        <th>Yorum</th>
                        <th>Tarih</th>
                        <th>Durum</th>
                        <th>İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td data-label="Yorum Sahibi">
                                <div class="cell-title">@item.NameSurname</div>
                            </td>
                            <td data-label="Tur">
                                <span class="loc-badge"><i class="bi bi-map"></i>@item.TourTitle</span>
                            </td>
                            <td data-label="Puan">
                                <div>
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        <i class="bi @(i <= item.Score ? "bi-star-fill" : "bi-star")" style="color:#f5a623;"></i>
                                    }
                                </div>
                            </td>
                            <td data-label="Yorum">
                                <div class="cell-title" style="font-weight:600;">@item.Headline</div>
                                <div class="cell-muted mt-1">
                                    @(item.CommentDetail?.Length > 70 ? item.CommentDetail.Substring(0, 70) + "…" : item.CommentDetail)
                                </div>
                                @if (item.CommentDetail?.Length > 70)
                                {
                                    <button type="button" class="btn btn-link p-0 mt-1 read-more-btn"
                                            style="font-size:.75rem;text-decoration:none;"
                                            data-name="@item.NameSurname"
                                            data-detail="@item.CommentDetail">
                                        Devamını oku
                                    </button>
                                }
                            </td>
                            <td data-label="Tarih">
                                <span class="date-cell">@item.CommentDate.ToString("dd.MM.yyyy")</span>
                            </td>
                            <td data-label="Durum">
                                @if (item.IsStatus)
                                {
                                    <span class="pill pill-green">Onaylı</span>
                                }
                                else
                                {
                                    <span class="pill pill-amber">Bekliyor</span>
                                }
                            </td>
                            <td data-label="İşlemler">
                                <div class="action-group">
                                    @if (!item.IsStatus)
                                    {
                                        <a asp-action="ApproveComment" asp-route-id="@item.CommentId" asp-route-status="@status"
                                           class="btn-action btn-approve" title="Onayla">
                                            <i class="bi bi-check-lg"></i>
                                        </a>
                                    }
                                    else
                                    {
                                        <a asp-action="RejectComment" asp-route-id="@item.CommentId" asp-route-status="@status"
                                           class="btn-action btn-edit" title="Onayı Kaldır">
                                            <i class="bi bi-x-lg"></i>
                                        </a>
                                    }
                                    <a asp-action="DeleteComment" asp-route-id="@item.CommentId" asp-route-status="@status"
                                       class="btn-action btn-delete" title="Sil"
                                       onclick="return confirm('Bu yorum kalıcı olarak silinecek. Emin misiniz?');">
                                        <i class="bi bi-trash3"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<div class="modal fade" id="commentModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius:14px;border:0;">
            <div class="modal-header border-0">
                <h5 class="modal-title" id="commentModalTitle" style="font-family:var(--font-display);font-weight:700;"></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p id="commentModalBody" style="line-height:1.7;color:#2d3748;"></p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('.read-more-btn').forEach(function(btn) {
            btn.addEventListener('click', function() {
                document.getElementById('commentModalTitle').textContent = btn.getAttribute('data-name');
                document.getElementById('commentModalBody').textContent = btn.getAttribute('data-detail');
                new bootstrap.Modal(document.getElementById('commentModal')).show();
            });
        });
    </script>
}
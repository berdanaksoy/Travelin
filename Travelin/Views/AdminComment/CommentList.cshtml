@model List<ResultCommentDto>

@{
    ViewData["Title"] = "Yorumlar";
    ViewData["ActiveMenu"] = "comments";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    string status = ViewBag.Status as string;
    int pendingCount = ViewBag.PendingCount;
    var filter = ViewBag.Filter as Travelin.Dtos.CommentDtos.CommentFilterDto;
    var tours = ViewBag.Tours as List<Travelin.Dtos.TourDtos.ResultTourDto>;
}

<div class="page-header">
    <div>
        <h1 class="page-title">Yorumlar</h1>
        <nav aria-label="breadcrumb" class="mt-2">
            <ol class="breadcrumb">
                <li class="breadcrumb-item">İşlemler</li>
                <li class="breadcrumb-item active">Yorumlar</li>
            </ol>
        </nav>
    </div>
</div>

@if (pendingCount > 0)
{
    <div class="alert alert-warning d-flex align-items-center gap-2" style="border-radius:10px;font-size:.875rem;">
        <i class="bi bi-clock-history"></i>
        <span><strong>@pendingCount</strong> yorum onay bekliyor.</span>
    </div>
}

<div class="form-section">
    <div class="section-body py-3">
        <div class="d-flex gap-2 flex-wrap mb-3">
            <a asp-action="CommentList"
               class="btn btn-sm @(string.IsNullOrEmpty(status) ? "btn-primary" : "btn-outline-secondary")"
               style="border-radius:8px;">Tümü</a>
            <a asp-action="CommentList" asp-route-status="pending"
               class="btn btn-sm @(status == "pending" ? "btn-primary" : "btn-outline-secondary")"
               style="border-radius:8px;">Onay Bekleyenler</a>
            <a asp-action="CommentList" asp-route-status="approved"
               class="btn btn-sm @(status == "approved" ? "btn-primary" : "btn-outline-secondary")"
               style="border-radius:8px;">Onaylananlar</a>
        </div>

        <form asp-action="CommentList" method="get" class="row g-2">
            <input type="hidden" name="status" value="@status" />

            <div class="col-md-6">
                <select name="tourId" class="form-control form-control-sm" style="border-radius:8px;">
                    <option value="">Tüm Turlar</option>
                    @if (tours != null)
                    {
                        @foreach (var t in tours)
                        {
                            <option value="@t.TourId" selected="@(filter?.TourId == t.TourId)">@t.Title</option>
                        }
                    }
                </select>
            </div>

            <div class="col-md-3">
                <select name="sortBy" class="form-control form-control-sm" style="border-radius:8px;">
                    <option value="" selected="@(string.IsNullOrEmpty(filter?.SortBy))">En Yeni</option>
                    <option value="oldest" selected="@(filter?.SortBy == "oldest")">En Eski</option>
                    <option value="scoreDesc" selected="@(filter?.SortBy == "scoreDesc")">Puan (Yüksek→Düşük)</option>
                    <option value="scoreAsc" selected="@(filter?.SortBy == "scoreAsc")">Puan (Düşük→Yüksek)</option>
                </select>
            </div>

            <div class="col-md-3 d-flex gap-1">
                <button type="submit" class="btn btn-primary btn-sm flex-fill d-flex align-items-center justify-content-center" style="border-radius:8px;" title="Filtrele">
                    <i class="bi bi-funnel"></i>
                </button>
                <a asp-action="CommentList" asp-route-status="@status" class="btn btn-outline-secondary btn-sm d-flex align-items-center justify-content-center" style="border-radius:8px;min-width:38px;" title="Temizle">
                    <i class="bi bi-x-lg"></i>
                </a>
            </div>
        </form>
    </div>
</div>

<div class="table-card">
    <div class="table-card-header">
        <div class="title">
            <i class="bi bi-star" style="color:#a0aec0;"></i>
            Yorum Listesi
            <span class="record-count">@ViewBag.TotalCount yorum</span>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="empty-state">
            <i class="bi bi-chat-square-text"></i>
            <p>Gösterilecek yorum bulunamadı.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Yorum Sahibi</th>
                        <th>Tur</th>
                        <th>Puan</th>
                        <th>Yorum</th>
                        <th>Tarih</th>
                        <th>Durum</th>
                        <th>İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td data-label="Yorum Sahibi">
                                <div class="cell-title">@item.NameSurname</div>
                            </td>
                            <td data-label="Tur">
                                <span class="loc-badge"><i class="bi bi-map"></i>@item.TourTitle</span>
                            </td>
                            <td data-label="Puan">
                                <div>
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        <i class="bi @(i <= item.Score ? "bi-star-fill" : "bi-star")" style="color:#f5a623;"></i>
                                    }
                                </div>
                            </td>
                            <td data-label="Yorum">
                                <div class="cell-title" style="font-weight:600;">@item.Headline</div>
                                <div class="cell-muted mt-1">
                                    @(item.CommentDetail?.Length > 70 ? item.CommentDetail.Substring(0, 70) + "…" : item.CommentDetail)
                                </div>
                                @if (item.CommentDetail?.Length > 70)
                                {
                                    <button type="button" class="btn btn-link p-0 mt-1 read-more-btn"
                                            style="font-size:.75rem;text-decoration:none;"
                                            data-name="@item.NameSurname"
                                            data-detail="@item.CommentDetail">
                                        Devamını oku
                                    </button>
                                }
                            </td>
                            <td data-label="Tarih">
                                <span class="date-cell">@item.CommentDate.ToString("dd.MM.yyyy")</span>
                            </td>
                            <td data-label="Durum">
                                @if (item.IsStatus)
                                {
                                    <span class="pill pill-green">Onaylı</span>
                                }
                                else
                                {
                                    <span class="pill pill-amber">Bekliyor</span>
                                }
                            </td>
                            <td data-label="İşlemler">
                                <div class="action-group">
                                    @if (!item.IsStatus)
                                    {
                                        <button type="button" class="btn-action btn-approve js-status-btn" title="Onayla"
                                                data-action="approve"
                                                data-url="@Url.Action("ApproveComment", new { id = item.CommentId, status = status, tourId = filter?.TourId, sortBy = filter?.SortBy, page = filter?.Page })"
                                                data-title="Yorumu Onayla"
                                                data-body="Bu yorum onaylanacak ve sitede yayınlanacak."
                                                data-heading="@item.NameSurname"
                                                data-subtext="@item.TourTitle"
                                                data-detail="@item.Headline">
                                            <i class="bi bi-check-lg"></i>
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn-action btn-edit js-status-btn" title="Onayı Kaldır"
                                                data-action="cancel"
                                                data-url="@Url.Action("RejectComment", new { id = item.CommentId, status = status, tourId = filter?.TourId, sortBy = filter?.SortBy, page = filter?.Page })"
                                                data-title="Onayı Kaldır"
                                                data-body="Bu yorumun onayı kaldırılacak ve sitede görünmeyecek."
                                                data-heading="@item.NameSurname"
                                                data-subtext="@item.TourTitle"
                                                data-detail="@item.Headline">
                                            <i class="bi bi-x-lg"></i>
                                        </button>
                                    }
                                    <button type="button" class="btn-action btn-delete js-delete-btn" title="Sil"
                                            data-url="@Url.Action("DeleteComment", new { id = item.CommentId, status = status, tourId = filter?.TourId, sortBy = filter?.SortBy, page = filter?.Page })"
                                            data-title="Yorum Silinecek"
                                            data-body="@item.NameSurname adlı kullanıcının yorumu kalıcı olarak silinecek. Emin misiniz?">
                                        <i class="bi bi-trash3"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<partial name="_AdminPagination" />

<div class="modal fade" id="commentModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius:14px;border:0;">
            <div class="modal-header border-0">
                <h5 class="modal-title" id="commentModalTitle" style="font-family:var(--font-display);font-weight:700;"></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p id="commentModalBody" style="line-height:1.7;color:#2d3748;"></p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('.read-more-btn').forEach(function(btn) {
            btn.addEventListener('click', function() {
                document.getElementById('commentModalTitle').textContent = btn.getAttribute('data-name');
                document.getElementById('commentModalBody').textContent = btn.getAttribute('data-detail');
                new bootstrap.Modal(document.getElementById('commentModal')).show();
            });
        });
    </script>
}
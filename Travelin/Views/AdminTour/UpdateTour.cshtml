@model UpdateTourDto

@{
    ViewData["Title"] = "Tur Düzenle";
    ViewData["ActiveMenu"] = "tours";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Tur Düzenle</h1>
        <nav aria-label="breadcrumb" class="mt-2">
            <ol class="breadcrumb">
                <li class="breadcrumb-item">Admin</li>
                <li class="breadcrumb-item"><a asp-action="TourList">Turlar</a></li>
                <li class="breadcrumb-item active" aria-current="page">Tur Düzenle</li>
            </ol>
        </nav>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="AdminTourProgram" asp-action="ManageProgram" asp-route-id="@Model.TourId"
           class="btn btn-primary d-flex align-items-center gap-2"
           style="border-radius:10px;font-size:.875rem;padding:.55rem 1.1rem;">
            <i class="bi bi-list-check"></i> Programı Yönet
        </a>
        <a asp-action="TourList" class="btn btn-outline-secondary d-flex align-items-center gap-2"
           style="border-radius:10px;font-size:.875rem;padding:.55rem 1.1rem;">
            <i class="bi bi-arrow-left"></i> Listeye Dön
        </a>
    </div>
</div>

<form method="post" id="tourForm">
    <input type="hidden" asp-for="TourId" />
    <div class="form-grid">
        <div class="form-main">

            <div class="form-section">
                <div class="section-header">
                    <div class="section-icon blue"><i class="bi bi-info-circle"></i></div>
                    <div>
                        <div class="section-title">Temel Bilgiler</div>
                        <div class="section-subtitle">Turun başlığı ve açıklaması</div>
                    </div>
                </div>
                <div class="section-body">
                    <div class="field-group">
                        <label asp-for="Title" class="field-label">
                            Tur Başlığı <span class="required">*</span>
                        </label>
                        <input asp-for="Title" class="form-control" maxlength="120"
                               placeholder="Örn: Barcelona Kültür ve Deniz Turu" id="titleInput" />
                        <div class="char-counter" id="titleCounter">0 / 120</div>
                        <span asp-validation-for="Title" class="text-danger"></span>
                    </div>

                    <div class="field-group">
                        <label asp-for="Description" class="field-label">
                            Açıklama <span class="required">*</span>
                        </label>
                        <textarea asp-for="Description" class="form-control" maxlength="1000" rows="5"
                                  placeholder="Tur hakkında detaylı açıklama..." id="descInput"></textarea>
                        <div class="char-counter" id="descCounter">0 / 1000</div>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                    <div class="field-group">
                        <label asp-for="CategoryId" class="field-label">
                            Kategori <span class="required">*</span>
                        </label>
                        <select asp-for="CategoryId" class="form-select">
                            <option value="">Kategori seçiniz...</option>
                            @foreach (var category in ViewBag.Categories as List<ResultCategoryDto>)
                            {
                                <option value="@category.CategoryId">@category.CategoryName</option>
                            }
                        </select>
                        <span asp-validation-for="CategoryId" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="form-section">
                <div class="section-header">
                    <div class="section-icon green"><i class="bi bi-geo-alt"></i></div>
                    <div>
                        <div class="section-title">Konum Bilgileri</div>
                        <div class="section-subtitle">Turun gideceği ülke ve şehir</div>
                    </div>
                </div>
                <div class="section-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="field-group">
                                <label asp-for="Country" class="field-label">
                                    Ülke <span class="required">*</span>
                                </label>
                                <input asp-for="Country" class="form-control" placeholder="Örn: İspanya" id="countryInput" />
                                <span asp-validation-for="Country" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="field-group">
                                <label asp-for="City" class="field-label">
                                    Şehir <span class="required">*</span>
                                </label>
                                <input asp-for="City" class="form-control" placeholder="Örn: Barcelona" id="cityInput" />
                                <span asp-validation-for="City" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="form-section">
                <div class="section-header">
                    <div class="section-icon amber"><i class="bi bi-calendar3"></i></div>
                    <div>
                        <div class="section-title">Tur Detayları</div>
                        <div class="section-subtitle">Tarih, süre, kapasite ve fiyat</div>
                    </div>
                </div>
                <div class="section-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="field-group">
                                <label asp-for="TourDate" class="field-label">
                                    Tur Tarihi <span class="required">*</span>
                                </label>
                                <input asp-for="TourDate" type="date" class="form-control" id="dateInput"
                                       min="@DateTime.Now.ToString("yyyy-MM-dd")" />
                                <div class="field-hint">Bugünden önceki tarih seçilemez.</div>
                                <span asp-validation-for="TourDate" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="field-group">
                                <label asp-for="Price" class="field-label">
                                    Kişi Başı Fiyat (₺) <span class="required">*</span>
                                </label>
                                <input asp-for="Price" type="number" step="0.01" min="0.01" class="form-control" placeholder="0,00" id="priceInput" />
                                <span asp-validation-for="Price" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="field-group">
                                <label asp-for="Capacity" class="field-label">
                                    Kapasite <span class="required">*</span>
                                </label>
                                <div class="stepper">
                                    <button type="button" class="stepper-btn" onclick="stepCapacity(-1)">
                                        <i class="bi bi-dash"></i>
                                    </button>
                                    <input asp-for="Capacity" type="number" min="1" max="500" value="20" id="capacityInput" />
                                    <button type="button" class="stepper-btn" onclick="stepCapacity(1)">
                                        <i class="bi bi-plus"></i>
                                    </button>
                                </div>
                                <span asp-validation-for="Capacity" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="field-group">
                                <label class="field-label">
                                    Tur Süresi <span class="required">*</span>
                                </label>
                                <div class="duration-builder">
                                    <div class="duration-unit">
                                        <label for="dayCount">Gün</label>
                                        <input type="number" id="dayCount" min="1" max="30" value="3" class="form-control" />
                                    </div>
                                    <div class="duration-unit">
                                        <label for="nightCount">Gece</label>
                                        <input type="number" id="nightCount" min="0" max="30" value="2" class="form-control" />
                                    </div>
                                </div>
                                <input asp-for="DayNight" type="hidden" id="dayNightHidden" />
                                <div class="field-hint">Önizleme: <strong id="durationText">3 Gün / 2 Gece</strong></div>
                                <span asp-validation-for="DayNight" class="text-danger"></span>
                                <span id="durationError" class="text-danger" style="display:none;">Tur en az 1 gün olmalıdır.</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="form-section">
                <div class="section-header">
                    <div class="section-icon purple"><i class="bi bi-image"></i></div>
                    <div>
                        <div class="section-title">Görseller</div>
                        <div class="section-subtitle">Kapak fotoğrafı ve konum görseli</div>
                    </div>
                </div>
                <div class="section-body">
                    <div class="field-group">
                        <label asp-for="ImageUrl" class="field-label">
                            Kapak Görseli URL <span class="required">*</span>
                        </label>
                        <input asp-for="ImageUrl" type="url" class="form-control"
                               placeholder="https://ornek.com/gorsel.jpg" id="imageUrlInput" />
                        <div class="field-hint">Tur listesinde ve detay sayfasında görünecek fotoğraf.</div>
                        <span asp-validation-for="ImageUrl" class="text-danger"></span>
                        <img src="" alt="Önizleme" class="url-preview-thumb" id="imagePreview" />
                    </div>

                    <div class="field-group">
                        <label asp-for="LocationImageUrl" class="field-label">
                            Konum Görseli URL
                        </label>
                        <input asp-for="LocationImageUrl" type="url" class="form-control"
                               placeholder="https://ornek.com/harita.jpg" id="locationUrlInput" />
                        <div class="field-hint">Detay sayfasında harita yerine gösterilecek görsel (Gemini ile üretilebilir).</div>
                        <span asp-validation-for="LocationImageUrl" class="text-danger"></span>
                        <img src="" alt="Önizleme" class="url-preview-thumb" id="locationPreview" />
                    </div>

                    <div class="field-group">
                        <label asp-for="VideoUrl" class="field-label">Tanıtım Videosu</label>
                        <input asp-for="VideoUrl" type="url" class="form-control"
                               placeholder="Herhangi bir YouTube linki" />
                        <div class="field-hint">Herhangi bir YouTube linki</div>
                        <span asp-validation-for="VideoUrl" class="text-danger"></span>
                    </div>
                </div>
            </div>

        </div>

        <div class="sidebar-panel">

            <div class="form-section">
                <div class="section-header">
                    <div class="section-icon green"><i class="bi bi-send-check"></i></div>
                    <div>
                        <div class="section-title">Yayım Durumu</div>
                        <div class="section-subtitle">Sitede görünsün mü?</div>
                    </div>
                </div>
                <div class="section-body">
                    <div class="form-check mb-2">
                        <input type="radio" name="IsStatus" value="true" checked="@(Model.IsStatus)" class="form-check-input" id="statusActive" />
                        <label class="form-check-label" for="statusActive">
                            <strong>Aktif</strong> — sitede görünür
                        </label>
                    </div>
                    <div class="form-check">
                        <input type="radio" name="IsStatus" value="false" checked="@(!Model.IsStatus)" class="form-check-input" id="statusPassive" />
                        <label class="form-check-label" for="statusPassive">
                            <strong>Pasif</strong> — sitede gizli
                        </label>
                    </div>
                </div>
            </div>

            <div class="form-section">
                <div class="section-header">
                    <div class="section-icon blue"><i class="bi bi-eye"></i></div>
                    <div>
                        <div class="section-title">Tur Özeti</div>
                        <div class="section-subtitle">Canlı önizleme</div>
                    </div>
                </div>
                <div class="section-body">
                    <div class="summary-box">
                        <div class="summary-row">
                            <span class="label">Başlık</span>
                            <span class="value" id="sumTitle">—</span>
                        </div>
                        <div class="summary-row">
                            <span class="label">Konum</span>
                            <span class="value" id="sumLocation">—</span>
                        </div>
                        <div class="summary-row">
                            <span class="label">Tarih</span>
                            <span class="value" id="sumDate">—</span>
                        </div>
                        <div class="summary-row">
                            <span class="label">Süre</span>
                            <span class="value" id="sumDuration">—</span>
                        </div>
                        <div class="summary-row">
                            <span class="label">Kapasite</span>
                            <span class="value" id="sumCapacity">—</span>
                        </div>
                        <div class="summary-row">
                            <span class="label">Fiyat</span>
                            <span class="value" id="sumPrice">—</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="form-section">
                <div class="section-body">
                    <div class="form-actions">
                        <button type="submit" class="btn-submit">
                            <i class="bi bi-plus-circle-fill"></i> Turu Kaydet
                        </button>
                        <a asp-action="TourList" class="btn-cancel">İptal et, geri dön</a>
                    </div>
                </div>
            </div>

        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.getElementById('tourForm').addEventListener('submit', function(e) {
            var days = parseInt(document.getElementById('dayCount').value) || 0;
            var errorEl = document.getElementById('durationError');
            if (days < 1) {
                e.preventDefault();
                errorEl.style.display = 'block';
                document.getElementById('dayCount').focus();
            } else {
                errorEl.style.display = 'none';
            }
        });

        document.getElementById('dayCount').addEventListener('blur', function() {
            var val = parseInt(this.value);
            if (this.value === '' || isNaN(val) || val < 1) this.value = 1;
            else if (val > 30) this.value = 30;
            updateDuration();
        });

        document.getElementById('nightCount').addEventListener('blur', function() {
            var val = parseInt(this.value);
            if (this.value === '' || isNaN(val) || val < 0) this.value = 0;
            else if (val > 30) this.value = 30;
            updateDuration();
        });

        var parts = '@Model.DayNight'.match(/\d+/g);
        if (parts) {
            document.getElementById('dayCount').value = parts[0] || 3;
            document.getElementById('nightCount').value = parts[1] || 2;
        }

        function initCounter(inputId, counterId, max) {
            var el = document.getElementById(inputId);
            var counter = document.getElementById(counterId);
            el.addEventListener('input', function () {
                counter.textContent = el.value.length + ' / ' + max;
            });
        }

        initCounter('titleInput', 'titleCounter', 120);
        initCounter('descInput', 'descCounter', 1000);

        function stepCapacity(delta) {
            var inp = document.getElementById('capacityInput');
            var val = (parseInt(inp.value) || 1) + delta;
            if (val >= 1 && val <= 500) {
                inp.value = val;
                updateSummary();
            }
        }

        function updateDuration() {
            var days = parseInt(document.getElementById('dayCount').value) || 0;
            var nights = parseInt(document.getElementById('nightCount').value) || 0;
            var text = days + ' Gün / ' + nights + ' Gece';
            document.getElementById('dayNightHidden').value = text;
            document.getElementById('durationText').textContent = text;
            updateSummary();
        }

        document.getElementById('dayCount').addEventListener('input', updateDuration);
        document.getElementById('nightCount').addEventListener('input', updateDuration);

        function bindPreview(inputId, imgId) {
            var input = document.getElementById(inputId);
            var img = document.getElementById(imgId);
            input.addEventListener('change', function () {
                var url = input.value.trim();
                if (url) {
                    img.src = url;
                    img.style.display = 'block';
                    img.onerror = function () { img.style.display = 'none'; };
                } else {
                    img.style.display = 'none';
                }
            });
        }

        bindPreview('imageUrlInput', 'imagePreview');
        bindPreview('locationUrlInput', 'locationPreview');

        function updateSummary() {
            var title = document.getElementById('titleInput').value.trim();
            var country = document.getElementById('countryInput').value.trim();
            var city = document.getElementById('cityInput').value.trim();
            var date = document.getElementById('dateInput').value;
            var duration = document.getElementById('dayNightHidden').value;
            var capacity = document.getElementById('capacityInput').value;
            var price = document.getElementById('priceInput').value;

            document.getElementById('sumTitle').textContent = title || '—';
            document.getElementById('sumLocation').textContent = (country && city) ? country + ' / ' + city : (country || city || '—');
            document.getElementById('sumDate').textContent = date ? date.split('-').reverse().join('.') : '—';
            document.getElementById('sumDuration').textContent = duration || '—';
            document.getElementById('sumCapacity').textContent = capacity ? capacity + ' kişi' : '—';
            document.getElementById('sumPrice').textContent = price ? price + ' ₺' : '—';
        }

        ['titleInput', 'countryInput', 'cityInput', 'dateInput', 'capacityInput', 'priceInput'].forEach(function (id) {
            document.getElementById(id).addEventListener('input', updateSummary);
        });

        updateDuration();
        updateSummary();
    </script>
}
@model List<ResultTourDto>

@{
    ViewData["Title"] = "Tur Listesi";
    ViewData["ActiveMenu"] = "tours";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    var filter = ViewBag.Filter as TourFilterDto;
    int currentPage = ViewBag.CurrentPage;
    int totalPages = ViewBag.TotalPages;
    long totalCount = ViewBag.TotalCount;

    var countries = ViewBag.Countries as List<string>;

    int windowSize = 2;
    int startPage = Math.Max(1, currentPage - windowSize);
    int endPage = Math.Min(totalPages, currentPage + windowSize);
}

@if (TempData["TourDeleteError"] != null)
{
    <div class="alert alert-danger" style="border-radius:10px;font-size:.875rem;">
        <i class="bi bi-exclamation-triangle me-2"></i>@TempData["TourDeleteError"]
    </div>
}

<div class="page-header">
    <div>
        <h1 class="page-title">Tur Listesi</h1>
        <nav aria-label="breadcrumb" class="mt-2">
            <ol class="breadcrumb">
                <li class="breadcrumb-item">Katalog</li>
                <li class="breadcrumb-item active" aria-current="page">Turlar</li>
            </ol>
        </nav>
    </div>
    <a asp-action="CreateTour" class="btn btn-primary d-flex align-items-center gap-2"
       style="border-radius:10px;font-size:.875rem;font-weight:600;padding:.55rem 1.1rem;">
        <i class="bi bi-plus-lg"></i> Yeni Tur Ekle
    </a>
</div>

<div class="form-section">
    <div class="section-body">
        <form method="get" asp-action="TourList">
            <div class="row g-2 align-items-end">
                <div class="col-12 col-md-4">
                    <label class="field-label">Ara</label>
                    <input type="text" name="search" value="@filter?.Search" class="form-control" placeholder="Tur adı veya şehir..." />
                </div>

                <div class="col-6 col-md-4">
                    <label class="field-label">Ülke</label>
                    <select name="country" class="form-select">
                        <option value="">Tümü</option>
                        @foreach (var c in countries ?? new List<string>())
                        {
                            <option value="@c" selected="@(filter?.Country == c)">@c</option>
                        }
                    </select>
                </div>

                <div class="col-6 col-md-4">
                    <label class="field-label">Kategori</label>
                    <select name="categoryId" class="form-select">
                        <option value="">Tümü</option>
                        @foreach (var cat in (ViewBag.Categories as List<ResultCategoryDto>) ?? new List<ResultCategoryDto>())
                        {
                            <option value="@cat.CategoryId" selected="@(filter?.CategoryId == cat.CategoryId)">@cat.CategoryName</option>
                        }
                    </select>
                </div>

                <div class="col-6 col-md-3">
                    <label class="field-label">Başlangıç</label>
                    <input type="date" name="fromDate" class="form-control" value="@(filter?.FromDate?.ToString("yyyy-MM-dd"))" />
                </div>

                <div class="col-6 col-md-3">
                    <label class="field-label">Bitiş</label>
                    <input type="date" name="toDate" class="form-control" value="@(filter?.ToDate?.ToString("yyyy-MM-dd"))" />
                </div>

                <div class="col-8 col-md-4">
                    <label class="field-label">Sırala</label>
                    <select name="sortBy" class="form-select">
                        <option value="newest" selected="@(filter?.SortBy == "newest" || string.IsNullOrEmpty(filter?.SortBy))">En Yeni</option>
                        <option value="oldest" selected="@(filter?.SortBy == "oldest")">En Eski</option>
                        <option value="titleAsc" selected="@(filter?.SortBy == "titleAsc")">A-Z</option>
                        <option value="capacity" selected="@(filter?.SortBy == "capacity")">Kapasite</option>
                        <option value="priceAsc" selected="@(filter?.SortBy == "priceAsc")">Fiyat ↑</option>
                        <option value="priceDesc" selected="@(filter?.SortBy == "priceDesc")">Fiyat ↓</option>
                    </select>
                </div>

                <div class="col-4 col-md-2 d-flex gap-2 align-items-end">
                    <button type="submit" class="btn btn-primary flex-fill" style="border-radius:8px;" title="Filtrele">
                        <i class="bi bi-funnel"></i>
                    </button>
                    <a asp-action="TourList" class="btn btn-outline-secondary" style="border-radius:8px;" title="Temizle">
                        <i class="bi bi-x-lg"></i>
                    </a>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="table-card">
    <div class="table-card-header">
        <div class="title">
            <i class="bi bi-table" style="color:#a0aec0;"></i>
            Tüm Turlar
            <span class="record-count">@totalCount tur</span>
        </div>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="empty-state">
            <i class="bi bi-map"></i>
            <p>Gösterilecek tur bulunamadı.</p>
            <a asp-action="CreateTour" class="btn btn-primary btn-sm mt-2" style="border-radius:8px;">Yeni Tur Ekle</a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Tur</th>
                        <th>Tarih</th>
                        <th>Süre / Kapasite</th>
                        <th>Fiyat</th>
                        <th>Kategori / Durum</th>
                        <th>İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td data-label="Tur">
                                <div class="d-flex align-items-center gap-3">
                                    @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                                    {
                                        <img src="@item.ImageUrl" alt="@item.Title" class="row-thumb" loading="lazy" />
                                    }
                                    else
                                    {
                                        <div class="thumb-placeholder"><i class="bi bi-image"></i></div>
                                    }
                                    <div>
                                        <div class="cell-title" title="@item.Title">@item.Title</div>
                                        <div class="loc-badge mt-1"><i class="bi bi-geo-alt"></i>@item.Country / @item.City</div>
                                    </div>
                                </div>
                            </td>
                            <td data-label="Tarih">
                                <span class="date-cell">@item.TourDate.ToString("dd.MM.yyyy")</span>
                            </td>
                            <td data-label="Süre / Kapasite">
                                <span class="pill pill-amber">@item.DayNight</span>
                                <div class="cap-cell mt-1"><i class="bi bi-people"></i>@item.Capacity kişi</div>
                            </td>
                            <td data-label="Fiyat">
                                <span class="date-cell">@item.Price.ToString("N2") ₺</span>
                            </td>
                            <td data-label="Kategori / Durum">
                                <span class="pill pill-blue">@item.CategoryName</span>
                                <div class="mt-1">
                                    @if (item.IsStatus)
                                    {
                                        <span class="pill pill-green">Aktif</span>
                                    }
                                    else
                                    {
                                        <span class="pill pill-gray">Pasif</span>
                                    }
                                </div>
                            </td>
                            <td data-label="İşlemler">
                                <div class="action-group">
                                    <a asp-controller="AdminTourProgram" asp-action="ManageProgram" asp-route-id="@item.TourId"
                                       class="btn-action btn-detail" title="Programı Yönet">
                                        <i class="bi bi-list-check"></i>
                                    </a>
                                    <a asp-controller="AdminCustomer" asp-action="TourCustomers" asp-route-id="@item.TourId"
                                       class="btn-action btn-detail" title="Tura Kayıtlı Müşteriler">
                                        <i class="bi bi-people"></i>
                                    </a>
                                    <a asp-action="UpdateTour" asp-route-id="@item.TourId"
                                       class="btn-action btn-edit" title="Düzenle">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <button type="button" class="btn-action btn-delete js-delete-btn" title="Sil"
                                            data-url="@Url.Action("DeleteTour", new { id = item.TourId })"
                                            data-title="Tur Silinecek"
                                            data-body="'@item.Title' turu ve ilişkili tüm veriler (yorumlar, program) silinecek. Emin misiniz?">
                                        <i class="bi bi-trash3"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <partial name="_AdminPagination" />
    }
</div>
@{
    ViewData["Title"] = "Tur Listesi";
    ViewData["BreadcrumbTitle"] = Localizer["Tours"].Value;
    ViewData["BreadcrumbSubtitle"] = Localizer["CurrentTours"].Value;

    int currentPage = 1;
    int.TryParse(Context.Request.Query["page"], out currentPage);
    if (currentPage < 1) currentPage = 1;
}

<partial name="_Breadcrumb" />

@await Component.InvokeAsync("TourList", new { page = currentPage })
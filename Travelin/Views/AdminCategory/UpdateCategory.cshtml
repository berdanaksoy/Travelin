@model UpdateCategoryDto

@{
    ViewData["Title"] = "Kategori Düzenle";
    ViewData["ActiveMenu"] = "categories";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Kategori Düzenle</h1>
        <nav aria-label="breadcrumb" class="mt-2">
            <ol class="breadcrumb">
                <li class="breadcrumb-item">Admin</li>
                <li class="breadcrumb-item"><a asp-action="CategoryList">Kategoriler</a></li>
                <li class="breadcrumb-item active">Kategori Düzenle</li>
            </ol>
        </nav>
    </div>
    <a asp-action="CategoryList" class="btn btn-outline-secondary d-flex align-items-center gap-2"
       style="border-radius:10px;font-size:.875rem;padding:.55rem 1.1rem;">
        <i class="bi bi-arrow-left"></i> Listeye Dön
    </a>
</div>

<form method="post">
    <input type="hidden" asp-for="CategoryId" />
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="form-section">
                <div class="section-header">
                    <div class="section-icon blue"><i class="bi bi-tag"></i></div>
                    <div>
                        <div class="section-title">Kategori Bilgileri</div>
                        <div class="section-subtitle">Turları gruplamak için kategori</div>
                    </div>
                </div>
                <div class="section-body">
                    <div class="field-group">
                        <label asp-for="CategoryName" class="field-label">
                            Kategori Adı <span class="required">*</span>
                        </label>
                        <input asp-for="CategoryName" class="form-control" placeholder="Örn: Kültür Turları" />
                    </div>

                    <div class="field-group">
                        <label asp-for="IconUrl" class="field-label">İkon / Görsel URL</label>
                        <input asp-for="IconUrl" type="url" class="form-control" placeholder="https://..." id="iconUrlInput" />
                        <img src="" alt="Önizleme" class="url-preview-thumb" id="iconPreview" />
                    </div>

                    <div class="field-group">
                        <label class="field-label">Durum</label>
                        <div class="form-check mb-2">
                            <input asp-for="IsStatus" type="radio" value="true" checked="@(Model.IsStatus)" class="form-check-input" id="statusActive" />
                            <label class="form-check-label" for="statusActive"><strong>Aktif</strong></label>
                        </div>
                        <div class="form-check">
                            <input asp-for="IsStatus" type="radio" value="false" checked="@(!Model.IsStatus)" class="form-check-input" id="statusPassive" />
                            <label class="form-check-label" for="statusPassive"><strong>Pasif</strong></label>
                        </div>
                    </div>

                    <div class="form-actions mt-4">
                        <button type="submit" class="btn-submit">
                            <i class="bi bi-plus-circle-fill"></i> Kategoriyi Güncelle
                        </button>
                        <a asp-action="CategoryList" class="btn-cancel">İptal et, geri dön</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <script>
        var input = document.getElementById('iconUrlInput');
        var img = document.getElementById('iconPreview');
        input.addEventListener('change', function () {
            var url = input.value.trim();
            if (url) {
                img.src = url;
                img.style.display = 'block';
                img.onerror = function () { img.style.display = 'none'; };
            } else {
                img.style.display = 'none';
            }
        });
    </script>
}
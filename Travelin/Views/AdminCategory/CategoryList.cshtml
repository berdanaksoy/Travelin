@model List<ResultCategoryDto>

@{
    ViewData["Title"] = "Kategoriler";
    ViewData["ActiveMenu"] = "categories";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Kategoriler</h1>
        <nav aria-label="breadcrumb" class="mt-2">
            <ol class="breadcrumb">
                <li class="breadcrumb-item">Admin</li>
                <li class="breadcrumb-item active" aria-current="page">Kategoriler</li>
            </ol>
        </nav>
    </div>
    <a asp-action="CreateCategory" class="btn btn-primary d-flex align-items-center gap-2"
       style="border-radius:10px;font-size:.875rem;font-weight:600;padding:.55rem 1.1rem;">
        <i class="bi bi-plus-lg"></i> Yeni Kategori
    </a>
</div>

<div class="table-card">
    <div class="table-card-header">
        <div class="title">
            <i class="bi bi-tags" style="color:#a0aec0;"></i>
            Tüm Kategoriler
            <span class="record-count">@Model.Count kategori</span>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="empty-state">
            <i class="bi bi-tags"></i>
            <p>Henüz kategori eklenmemiş.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>İkon</th>
                        <th>Kategori Adı</th>
                        <th>Durum</th>
                        <th>İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="td-image" data-label="">
                                @if (!string.IsNullOrWhiteSpace(item.IconUrl))
                                {
                                    <img src="@item.IconUrl" alt="@item.CategoryName" class="row-thumb" loading="lazy" />
                                }
                                else
                                {
                                    <div class="thumb-placeholder"><i class="bi bi-tag"></i></div>
                                }
                            </td>
                            <td data-label="Ad">
                                <span class="cell-title">@item.CategoryName</span>
                            </td>
                            <td data-label="Durum">
                                @if (item.IsStatus)
                                {
                                    <span class="pill pill-green">Aktif</span>
                                }
                                else
                                {
                                    <span class="pill pill-gray">Pasif</span>
                                }
                            </td>
                            <td data-label="İşlemler">
                                <div class="action-group">
                                    <a asp-action="UpdateCategory" asp-route-id="@item.CategoryId"
                                       class="btn-action btn-edit" title="Düzenle">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <button type="button" class="btn-action btn-delete js-delete-btn" title="Sil"
                                            data-url="@Url.Action("DeleteCategory", new { id = item.CategoryId })"
                                            data-title="Kategori Silinecek"
                                            data-body="'@item.CategoryName' kategorisi silinecek. Emin misiniz?">
                                        <i class="bi bi-trash3"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Tur Admin</title>
    <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />

    <link href="~/css/admin.css" rel="stylesheet" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    <div class="sidebar-overlay" id="sidebarOverlay" onclick="toggleSidebar()"></div>

    <!-- SIDEBAR -->
    @{
        var activeMenu = ViewData["ActiveMenu"] as string;
    }

    <!-- SIDEBAR -->
    <aside class="sidebar" id="sidebar">
        <a asp-controller="AdminTour" asp-action="TourList" class="sidebar-brand">
            <div class="brand-icon"><i class="bi bi-compass"></i></div>
            <div>
                <div class="brand-name">TourAdmin</div>
                <span class="brand-sub">Yönetim Paneli</span>
            </div>
        </a>

        <div class="sidebar-section">
            <div class="sidebar-section-label">Katalog</div>
            <a asp-controller="AdminTour" asp-action="TourList"
               class="nav-item-link @(activeMenu == "tours" ? "active" : "")">
                <i class="bi bi-map"></i> Turlar
            </a>
            <a asp-controller="AdminCategory" asp-action="CategoryList"
               class="nav-item-link @(activeMenu == "categories" ? "active" : "")">
                <i class="bi bi-tags"></i> Kategoriler
            </a>
            <a asp-controller="AdminTourProgram" asp-action="ProgramTourList"
               class="nav-item-link @(activeMenu == "programs" ? "active" : "")">
                <i class="bi bi-list-check"></i> Tur Programları
            </a>
        </div>

        <div class="sidebar-section">
            <div class="sidebar-section-label">İşlemler</div>
            <a asp-controller="AdminReservation" asp-action="ReservationList"
               class="nav-item-link @(activeMenu == "reservations" ? "active" : "")">
                <i class="bi bi-calendar2-check"></i> Rezervasyonlar
            </a>
            <a asp-controller="AdminComment" asp-action="CommentList"
               class="nav-item-link @(activeMenu == "comments" ? "active" : "")">
                <i class="bi bi-star"></i> Yorumlar
            </a>
        </div>

        <div class="sidebar-section">
            <div class="sidebar-section-label">Sistem</div>
            <a asp-controller="AdminSiteSetting" asp-action="Index"
               class="nav-item-link @(activeMenu == "settings" ? "active" : "")">
                <i class="bi bi-gear"></i> Site Ayarları
            </a>
            <a asp-controller="Home" asp-action="Index" class="nav-item-link">
                <i class="bi bi-box-arrow-up-right"></i> Siteye Dön
            </a>
        </div>
    </aside>

    <!-- TOPBAR -->
    <header class="topbar">
        <button class="hamburger" onclick="toggleSidebar()" aria-label="Menüyü aç/kapat">
            <i class="bi bi-list"></i>
        </button>
        <span class="topbar-title">@ViewData["Title"]</span>
        <div class="topbar-spacer"></div>
        <div class="topbar-actions">
            <div class="admin-profile">
                <div class="admin-avatar">A</div>
                <div>
                    <div class="admin-name">Yönetici</div>
                    <span class="admin-role">Travelin</span>
                </div>
            </div>
        </div>
    </header>

    <!-- MAIN -->
    <main class="main-wrapper">
        @RenderBody()
    </main>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function toggleSidebar() {
            document.getElementById('sidebar').classList.toggle('open');
            document.getElementById('sidebarOverlay').classList.toggle('show');
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
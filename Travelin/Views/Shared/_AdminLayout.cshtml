
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Tur Admin</title>
    <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />

    <link href="~/css/admin.css" rel="stylesheet" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    <div class="sidebar-overlay" id="sidebarOverlay" onclick="toggleSidebar()"></div>

    <!-- SIDEBAR -->
    @{
        var activeMenu = ViewData["ActiveMenu"] as string;
    }

    <!-- SIDEBAR -->
    <aside class="sidebar" id="sidebar">
        <a asp-controller="AdminTour" asp-action="TourList" class="sidebar-brand">
            <div class="brand-icon"><i class="bi bi-compass"></i></div>
            <div>
                <div class="brand-name">Travelin</div>
                <span class="brand-sub">Yönetim Paneli</span>
            </div>
        </a>

        <div class="sidebar-section">
            <div class="sidebar-section-label">Katalog</div>
            <a asp-controller="AdminTour" asp-action="TourList"
               class="nav-item-link @(activeMenu == "tours" ? "active" : "")">
                <i class="bi bi-map"></i> Turlar
            </a>
            <a asp-controller="AdminCategory" asp-action="CategoryList"
               class="nav-item-link @(activeMenu == "categories" ? "active" : "")">
                <i class="bi bi-tags"></i> Kategoriler
            </a>
            <a asp-controller="AdminTourProgram" asp-action="ProgramTourList"
               class="nav-item-link @(activeMenu == "programs" ? "active" : "")">
                <i class="bi bi-list-check"></i> Tur Programları
            </a>
        </div>

        <div class="sidebar-section">
            <div class="sidebar-section-label">İşlemler</div>
            <a asp-controller="AdminReservation" asp-action="ReservationList"
               class="nav-item-link @(activeMenu == "reservations" ? "active" : "")">
                <i class="bi bi-calendar2-check"></i> Rezervasyonlar
            </a>
            <a asp-controller="AdminComment" asp-action="CommentList"
               class="nav-item-link @(activeMenu == "comments" ? "active" : "")">
                <i class="bi bi-star"></i> Yorumlar
            </a>
        </div>

        <div class="sidebar-section">
            <div class="sidebar-section-label">Sistem</div>
            <a asp-controller="AdminSiteSetting" asp-action="Index"
               class="nav-item-link @(activeMenu == "settings" ? "active" : "")">
                <i class="bi bi-gear"></i> Site Ayarları
            </a>
            <a asp-controller="Home" asp-action="Index" class="nav-item-link">
                <i class="bi bi-box-arrow-up-right"></i> Siteye Dön
            </a>
        </div>
    </aside>

    <!-- TOPBAR -->
    <header class="topbar">
        <button class="hamburger" onclick="toggleSidebar()" aria-label="Menüyü aç/kapat">
            <i class="bi bi-list"></i>
        </button>
        <div class="topbar-spacer"></div>
        <div class="topbar-actions">
            <div class="admin-profile">
                <div class="admin-avatar">A</div>
                <div>
                    <div class="admin-name">Yönetici</div>
                    <span class="admin-role">Travelin</span>
                </div>
            </div>
        </div>
    </header>

    <!-- MAIN -->
    <main class="main-wrapper">
        @RenderBody()
    </main>

    @if (TempData["Success"] != null)
    {
        <div class="admin-toast admin-toast-success" id="adminToast">
            <i class="bi bi-check-circle-fill"></i>
            <span>@TempData["Success"]</span>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="admin-toast admin-toast-error" id="adminToast">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <span>@TempData["Error"]</span>
        </div>
    }

    <div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" style="max-width:420px">
            <div class="modal-content" style="border-radius:14px;border:0;">
                <div class="modal-body p-4 text-center">
                    <div style="width:60px;height:60px;background:#fff5f5;border-radius:50%;display:grid;place-items:center;margin:0 auto 1.25rem;font-size:1.5rem;color:#e53e3e;">
                        <i class="bi bi-exclamation-triangle"></i>
                    </div>
                    <h5 style="font-family:var(--font-display);font-weight:700;font-size:1.1rem;margin-bottom:.5rem;" id="deleteModalTitle">Silinecek</h5>
                    <p class="text-muted" style="font-size:.875rem;" id="deleteModalBody"></p>
                </div>
                <div class="modal-footer border-0 pt-0 pb-4 px-4 d-flex gap-2">
                    <button type="button" class="btn btn-light flex-fill" data-bs-dismiss="modal" style="border-radius:9px;">İptal</button>
                    <a href="#" id="deleteConfirmLink" class="btn btn-danger flex-fill" style="border-radius:9px;">
                        <i class="bi bi-trash3 me-1"></i> Evet, Sil
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="statusModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" style="max-width:440px">
            <div class="modal-content" style="border-radius:14px;border:0;">
                <div class="modal-body p-4 text-center">
                    <div id="statusModalIcon" style="width:60px;height:60px;border-radius:50%;display:grid;place-items:center;margin:0 auto 1.25rem;font-size:1.5rem;"></div>
                    <h5 style="font-weight:700;font-size:1.1rem;margin-bottom:.5rem;" id="statusModalTitle"></h5>
                    <p class="text-muted" style="font-size:.875rem;" id="statusModalBody"></p>
                    <div id="statusModalInfo" style="background:#f8f9fa;border-radius:10px;padding:12px;margin-top:12px;font-size:.85rem;text-align:left;"></div>
                </div>
                <div class="modal-footer border-0 pt-0 pb-4 px-4 d-flex gap-2">
                    <button type="button" class="btn btn-light flex-fill" data-bs-dismiss="modal" style="border-radius:9px;">Vazgeç</button>
                    <a href="#" id="statusConfirmLink" class="btn flex-fill" style="border-radius:9px;"></a>
                </div>
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        var deleteModal = document.getElementById('deleteModal');
        if (deleteModal) {
            var modalInstance = new bootstrap.Modal(deleteModal);
            document.querySelectorAll('.js-delete-btn').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    document.getElementById('deleteConfirmLink').href = this.dataset.url;
                    document.getElementById('deleteModalTitle').textContent = this.dataset.title || 'Silinecek';
                    document.getElementById('deleteModalBody').textContent = this.dataset.body || 'Bu kayıt silinecek. Emin misiniz?';
                    modalInstance.show();
                });
            });
        }

        var adminToast = document.getElementById('adminToast');
        if (adminToast) {
            setTimeout(function () {
                 adminToast.style.transition = 'opacity 0.5s, transform 0.5s';
                 adminToast.style.opacity = '0';
                 adminToast.style.transform = 'translateX(120%)';
                 setTimeout(function () { adminToast.style.display = 'none'; }, 500);
             }, 3000);
         }

         var statusModal = document.getElementById('statusModal');
         if (statusModal) {
            var statusModalInstance = new bootstrap.Modal(statusModal);
            document.querySelectorAll('.js-status-btn').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var isApprove = this.dataset.action === 'approve';
                    document.getElementById('statusConfirmLink').href = this.dataset.url;
                    document.getElementById('statusModalTitle').textContent = this.dataset.title;
                    document.getElementById('statusModalBody').textContent = this.dataset.body;
                    var heading = this.dataset.heading || '';
                    var subtext = this.dataset.subtext || '';
                    var detail = this.dataset.detail || '';
                    document.getElementById('statusModalInfo').innerHTML =
                        '<strong>' + heading + '</strong><br>' + subtext + (detail ? '<br>' + detail : '');

                    var icon = document.getElementById('statusModalIcon');
                    var link = document.getElementById('statusConfirmLink');
                    if (isApprove) {
                        icon.style.background = '#f0fdf4';
                        icon.style.color = '#16a34a';
                        icon.innerHTML = '<i class="bi bi-check-circle"></i>';
                        link.className = 'btn btn-success flex-fill';
                        link.innerHTML = '<i class="bi bi-check-lg me-1"></i> Evet, Onayla';
                    } else {
                        icon.style.background = '#fef2f2';
                        icon.style.color = '#dc2626';
                        icon.innerHTML = '<i class="bi bi-x-circle"></i>';
                        link.className = 'btn btn-danger flex-fill';
                        link.innerHTML = '<i class="bi bi-x-lg me-1"></i> Evet, İptal Et';
                    }
                    statusModalInstance.show();
                });
            });
        }

        function toggleSidebar() {
            document.getElementById('sidebar').classList.toggle('open');
            document.getElementById('sidebarOverlay').classList.toggle('show');
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
@{
    var filter = ViewBag.Filter as Travelin.Dtos.TourDtos.TourFilterDto;
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    string view = ViewBag.ViewMode as string ?? "list";

    int windowSize = 1;
    int startPage = Math.Max(1, currentPage - windowSize);
    int endPage = Math.Min(totalPages, currentPage + windowSize);

    string PageUrl(int p)
{
    var q = $"?page={p}&view={Uri.EscapeDataString(view)}";
    if (filter != null)
    {
        if (!string.IsNullOrEmpty(filter.Search)) q += $"&search={Uri.EscapeDataString(filter.Search)}";
        if (!string.IsNullOrEmpty(filter.CategoryId)) q += $"&categoryId={Uri.EscapeDataString(filter.CategoryId)}";
        if (!string.IsNullOrEmpty(filter.Country)) q += $"&country={Uri.EscapeDataString(filter.Country)}";
        if (filter.FromDate.HasValue) q += $"&fromDate={filter.FromDate:yyyy-MM-dd}";
        if (filter.ToDate.HasValue) q += $"&toDate={filter.ToDate:yyyy-MM-dd}";
        if (!string.IsNullOrEmpty(filter.SortBy)) q += $"&sortBy={Uri.EscapeDataString(filter.SortBy)}";
    }
    return "/Tour/TourList" + q;
}
}

@if (totalPages > 1)
{
    <div class="text-center mt-4">
        @if (currentPage > 1)
        {
            <a href="@PageUrl(currentPage - 1)" class="nir-btn me-2"><i class="fa fa-long-arrow-alt-left"></i></a>
        }

        @if (startPage > 1)
        {
            <a href="@PageUrl(1)" class="nir-btn me-1">1</a>
            @if (startPage > 2)
            {
                <span class="nir-btn me-1" style="pointer-events:none;opacity:.4;">…</span>
            }
        }

        @for (int i = startPage; i <= endPage; i++)
        {
            @if (i == currentPage)
            {
                <span class="nir-btn me-1" style="background:#0a5f5f;pointer-events:none;font-weight:700;box-shadow:inset 0 2px 4px rgba(0,0,0,.3);">@i</span>
            }
            else
            {
                <a href="@PageUrl(i)" class="nir-btn me-1">@i</a>
            }
        }

        @if (endPage < totalPages)
        {
            @if (endPage < totalPages - 1)
            {
                <span class="nir-btn me-1" style="pointer-events:none;opacity:.4;">…</span>
            }
            <a href="@PageUrl(totalPages)" class="nir-btn me-1">@totalPages</a>
        }

        @if (currentPage < totalPages)
        {
            <a href="@PageUrl(currentPage + 1)" class="nir-btn ms-2"><i class="fa fa-long-arrow-alt-right"></i></a>
        }
    </div>
}
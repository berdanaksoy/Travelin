@{
    var filter = ViewBag.Filter as Travelin.Dtos.TourDtos.TourFilterDto;
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    string view = ViewBag.ViewMode as string ?? "list";

    string PageUrl(int p)
    {
        var q = $"?page={p}&view={view}";
        if (filter != null)
        {
            if (!string.IsNullOrEmpty(filter.Search)) q += $"&search={filter.Search}";
            if (!string.IsNullOrEmpty(filter.CategoryId)) q += $"&categoryId={filter.CategoryId}";
            if (!string.IsNullOrEmpty(filter.Country)) q += $"&country={filter.Country}";
            if (filter.FromDate.HasValue) q += $"&fromDate={filter.FromDate:yyyy-MM-dd}";
            if (filter.ToDate.HasValue) q += $"&toDate={filter.ToDate:yyyy-MM-dd}";
            if (!string.IsNullOrEmpty(filter.SortBy)) q += $"&sortBy={filter.SortBy}";
        }
        return "/Tour/TourList" + q;
    }
}

@if (totalPages > 1)
{
    <div class="text-center mt-4">
        @if (currentPage > 1)
        {
            <a href="@PageUrl(currentPage - 1)" class="nir-btn me-2"><i class="fa fa-long-arrow-alt-left"></i></a>
        }
        @for (int i = 1; i <= totalPages; i++)
        {
            <a href="@PageUrl(i)" class="nir-btn me-1 @(i == currentPage ? "active" : "")">@i</a>
        }
        @if (currentPage < totalPages)
        {
            <a href="@PageUrl(currentPage + 1)" class="nir-btn ms-2"><i class="fa fa-long-arrow-alt-right"></i></a>
        }
    </div>
}
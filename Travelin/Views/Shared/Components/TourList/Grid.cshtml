@model List<ResultTourDto>

<div class="row">
    @foreach (var item in Model)
    {
        <div class="col-lg-6 col-md-6 mb-4">
            <div class="trend-item rounded box-shadow h-100">
                <div class="trend-image position-relative">
                    <img src="@item.ImageUrl" alt="@item.Title" style="width:100%;height:220px;object-fit:cover;" />
                    <div class="color-overlay"></div>
                    <span class="position-absolute" style="top:12px;right:12px;background:#17a2a2;color:#fff;padding:4px 12px;border-radius:20px;font-size:.8rem;font-weight:600;">
                        @item.DayNight
                    </span>
                    @if (item.TourDate < DateTime.Now)
                    {
                        <span class="position-absolute" style="top:12px;left:12px;background:#e53e3e;color:#fff;padding:4px 12px;border-radius:20px;font-size:.8rem;font-weight:600;">
                            @Localizer["TourExpired"]
                        </span>
                    }
                    else if (item.IsFull)
                    {
                        <span class="position-absolute" style="top:12px;left:12px;background:#e53e3e;color:#fff;padding:4px 12px;border-radius:20px;font-size:.8rem;font-weight:600;">
                            @Localizer["TourFull"]
                        </span>
                    }
                </div>
                <div class="trend-content p-4">
                    <h6 class="theme mb-1">
                        <a asp-controller="Tour" asp-action="TourList" asp-route-country="@item.Country" class="theme text-decoration-none">
                            <i class="icon-location-pin"></i> @item.Country
                        </a>
                    </h6>
                    <h3 class="mb-1" style="font-size:1.2rem;">
                        <a asp-controller="Tour" asp-action="Detail" asp-route-id="@item.TourId">@item.Title</a>
                    </h3>
                    <div class="rating-main d-flex align-items-center pb-2">
                        <div class="rating">
                            @for (int i = 1; i <= 5; i++)
                            {
                                <span class="fa fa-star" style="color:@(i <= Math.Round(item.AverageRating) ? "#f5a623" : "#d0d0d0");"></span>
                            }
                        </div>
                        <span class="ms-2">(@item.CommentCount)</span>
                    </div>
                    <p class="border-b pb-2 mb-2">@item.Description</p>
                    <div class="entry-meta d-flex align-items-center justify-content-between">
                        <p class="mb-0"><span class="theme fw-bold fs-5">@item.Price.ToString("N0") ₺</span> | @Localizer["PerPerson"]</p>
                        <a asp-controller="Tour" asp-action="Detail" asp-route-id="@item.TourId" class="nir-btn" style="padding:6px 16px;font-size:.85rem;">@Localizer["ViewDetail"]</a>
                    </div>
                </div>
            </div>
        </div>
    }

    <partial name="_TourPagination" />
</div>
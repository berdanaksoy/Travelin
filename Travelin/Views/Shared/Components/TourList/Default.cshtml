@model List<ResultTourDto>

<div class="destination-list">
    @foreach (var item in Model)
    {
        <div class="trend-full bg-white rounded box-shadow overflow-hidden p-4 mb-4">
            <div class="row">
                <div class="col-lg-4 col-md-3">
                    <div class="trend-item2 rounded position-relative">
                        <a asp-controller="Tour" asp-action="Detail" asp-route-id="@item.TourId" style="background-image: url(@item.ImageUrl);"></a>
                        <div class="color-overlay"></div>
                        @if (item.TourDate < DateTime.Now)
                        {
                            <span class="position-absolute" style="top:12px;left:12px;background:#e53e3e;color:#fff;padding:4px 12px;border-radius:20px;font-size:.8rem;font-weight:600;z-index:2;">
                                @Localizer["TourExpired"]
                            </span>
                        }
                    </div>
                </div>
                <div class="col-lg-5 col-md-6">
                    <div class="trend-content position-relative text-md-start text-center">
                        <small>@item.DayNight</small>
                        <h3 class="mb-1"><a asp-controller="Tour" asp-action="Detail" asp-route-id="@item.TourId">@item.Title</a></h3>
                        <h6 class="theme mb-2">
                            <a asp-controller="Tour" asp-action="TourList" asp-route-country="@item.Country" class="theme text-decoration-none">
                                <i class="icon-location-pin"></i> @item.Country
                            </a>
                        </h6>
                        <p class="mt-3 mb-2">@item.Description</p>
                        <div class="d-flex gap-3 flex-wrap" style="font-size:.85rem;color:#718096;">
                            <span><i class="fa fa-users theme"></i> @item.Capacity @Localizer["Person"]</span>
                        </div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-3">
                    <div class="trend-content text-md-end text-center">
                        <div class="rating">
                            @for (int i = 1; i <= 5; i++)
                            {
                                <span class="fa fa-star" style="color:@(i <= Math.Round(item.AverageRating) ? "#f5a623" : "#d0d0d0");"></span>
                            }
                        </div>
                        <small>@item.CommentCount @Localizer["Reviews"]</small>
                        <div class="trend-price my-2">
                            <h3 class="mb-0">@item.Price.ToString("N0") ₺</h3>
                            <small>@Localizer["PerPerson"]</small>
                        </div>
                        <a asp-controller="Tour" asp-action="Detail" asp-route-id="@item.TourId" class="nir-btn">@Localizer["ViewDetail"]</a>
                    </div>
                </div>
            </div>
        </div>
    }

    <partial name="_TourPagination" />
</div>
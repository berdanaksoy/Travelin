@model List<ResultCommentListByTourIdDto>

<div class="single-comments single-box mb-4">
    <h4 class="border-b pb-2 mb-2">@Model.Count @Localizer["Comments"]</h4>

    @if (!Model.Any())
    {
        <p>@Localizer["NoCommentsYet"]</p>
    }

    @foreach (var item in Model)
    {
        <div class="comment-box">
            <div class="comment-content rounded">
                <h5 class="mb-1">@item.NameSurname</h5>
                <p class="comment-date">@item.CommentDate.ToString("dd MMMM yyyy")</p>
                <div class="comment-rate">
                    <div class="rating mar-right-15">
                        @for (int i = 1; i <= 5; i++)
                        {
                            @if (i <= item.Score) { <span class="fa fa-star" style="color:#f5a623;"></span> }
                            else { <span class="fa fa-star" style="color:#d0d0d0;"></span> }
                        }
                    </div>
                    <span class="comment-title">@item.Headline</span>
                </div>
                <p class="comment">@item.CommentDetail</p>
            </div>
        </div>
    }
</div>
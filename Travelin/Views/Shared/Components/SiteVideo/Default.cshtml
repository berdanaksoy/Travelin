@model ResultSiteSettingDto

<style>
    .play-btn {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        background: #17a2a2 !important;
        color: #fff;
        font-size: 1.5rem;
        display: inline-grid;
        place-items: center;
        transition: transform .2s;
    }

        .play-btn:hover {
            transform: scale(1.1);
        }

        .play-btn i {
            margin-left: 4px;
        }

    .play-pulse {
        position: absolute;
        width: 80px;
        height: 80px;
        border-radius: 50%;
        background: #17a2a2;
        opacity: .4;
        animation: playPulse 1.8s ease-out infinite;
    }

    @@keyframes playPulse {
        0% {
            transform: scale(1);
            opacity: .4;
        }

        100% {
            transform: scale(1.8);
            opacity: 0;
        }
    }
</style>

@if (Model != null && !string.IsNullOrEmpty(Model.VideoUrl))
{
    <section class="discount-action pt-0" style="background-position:center;">
        <div class="container">
            <div class="call-banner rounded pt-8 pb-8">
                <div class="call-banner-inner w-75 mx-auto text-center px-5">
                    <div class="trend-content mb-5 pb-2 px-5">
                        <span class="text-uppercase" style="color:#17a2a2;font-weight:600;letter-spacing:1px;font-size:.85rem;">
                            @Localizer["VideoLabel"]
                        </span>
                        <h2 class="mb-2 mt-2">@Localizer["VideoHeading"]</h2>
                        <p class="text-muted mb-0">@Localizer["VideoDescription"]</p>
                    </div>
                    <div class="video-button text-center position-relative">
                        <div class="call-button text-center">
                            <button type="button" class="play-btn border-0 bg-transparent position-relative"
                                    data-bs-toggle="modal" data-bs-target="#siteVideoModal"
                                    style="cursor:pointer;">
                                <span class="play-pulse"></span>
                                <i class="fa fa-play"></i>
                            </button>
                            <p class="mt-4 mb-0" style="color:#2d3748;font-weight:600;">@Localizer["PlayVideo"]</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="white-overlay"></div>
    </section>

    <div class="modal fade" id="siteVideoModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content bg-transparent border-0">
                <div class="modal-body p-0 position-relative">
                    <button type="button" class="btn-close btn-close-white position-absolute"
                            style="top:-35px; right:0; z-index:10;"
                            data-bs-dismiss="modal" aria-label="Close"></button>
                    <div class="ratio ratio-16x9">
                        <iframe src="@Model.VideoUrl" title="Travelin" allowfullscreen
                                class="rounded"></iframe>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var modal = document.getElementById('siteVideoModal');
            var iframe = modal.querySelector('iframe');
            var src = iframe.getAttribute('src');

            modal.addEventListener('hidden.bs.modal', function() {
                iframe.setAttribute('src', src);
            });
        });
    </script>
}
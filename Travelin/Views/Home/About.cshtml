@{
    ViewData["Title"] = "Hakkımızda";
    ViewData["BreadcrumbTitle"] = Localizer["AboutUs"].Value;
    ViewData["BreadcrumbSubtitle"] = Localizer["AboutUsSubtitle"].Value;
}

<style>
    .why-us-item {
        position: relative;
        overflow: hidden;
        z-index: 1;
        transition: color 0.4s ease;
    }

    .why-us-item::before {
        content: '';
        position: absolute;
        left: 0;
        bottom: 0;
        width: 100%;
        height: 0;
        background: #17a2a2;
        transition: height 0.4s ease;
        z-index: -1;
    }

    .why-us-item:hover::before {
        height: 100%;
    }

    .why-us-item:hover,
    .why-us-item:hover h4,
    .why-us-item:hover h4 a,
    .why-us-item:hover p,
    .why-us-item:hover .theme {
        color: #fff !important;
    }
</style>

<partial name="_Breadcrumb" />

<section class="about-us pt-6 pb-6" style="background-image: url(/travelin/images/background_pattern.png); background-position: bottom right;">
    <div class="container">
        <div class="row d-flex align-items-center justify-content-between">
            <div class="col-lg-6 ps-lg-4">
                <div class="about-content text-center text-lg-start">
                    <h4 class="theme d-inline-block mb-0">@Localizer["AboutLabel"]</h4>
                    <h2 class="border-b mb-3 pb-2">@Localizer["AboutHeading"]</h2>
                    <p class="border-b mb-3 pb-3">@Localizer["AboutParagraph1"]</p>
                    <p class="mb-3">@Localizer["AboutParagraph2"]</p>
                    <div class="about-listing">
                        <ul class="d-flex justify-content-between flex-wrap gap-2 list-unstyled">
                            <li><i class="icon-location-pin theme"></i> @Localizer["AboutFeature1"]</li>
                            <li><i class="icon-briefcase theme"></i> @Localizer["AboutFeature3"]</li>
                            <li><i class="icon-folder theme"></i> @Localizer["AboutReliable"]</li>
                        </ul>
                    </div>
                </div>
            </div>
            <div class="col-lg-6 mb-4 pe-lg-4">
                <div class="about-image">
                    <img src="/travelin/images/travel.png" alt="@Localizer["AboutUs"]" class="img-fluid" />
                </div>
            </div>
        </div>

        <div class="counter-main mt-4">
            <div class="counter p-4 pb-0 box-shadow bg-white rounded">
                <div class="row text-center">
                    <div class="col-lg-3 col-md-6 mb-4">
                        <div class="counter-item border-end">
                            <h2 class="mb-0 theme"><span class="counter-num" data-target="10">0</span>+</h2>
                            <span>@Localizer["StatYears"]</span>
                        </div>
                    </div>
                    <div class="col-lg-3 col-md-6 mb-4">
                        <div class="counter-item border-end">
                            <h2 class="mb-0 theme"><span class="counter-num" data-target="120">0</span>+</h2>
                            <span>@Localizer["StatTours"]</span>
                        </div>
                    </div>
                    <div class="col-lg-3 col-md-6 mb-4">
                        <div class="counter-item border-end">
                            <h2 class="mb-0 theme"><span class="counter-num" data-target="500">0</span>+</h2>
                            <span>@Localizer["StatHappyCustomers"]</span>
                        </div>
                    </div>
                    <div class="col-lg-3 col-md-6 mb-4">
                        <div class="counter-item">
                            <h2 class="mb-0 theme"><span class="counter-num" data-target="50">0</span>+</h2>
                            <span>@Localizer["StatDestinations"]</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
</section>

<section class="about-us pb-6">
    <div class="container">
        <div class="section-title mb-5 mx-auto text-center" style="max-width:600px;">
            <h4 class="mb-1 theme">@Localizer["WhyUsLabel"]</h4>
            <h2 class="mb-1">@Localizer["WhyUsHeading"]</h2>
            <p>@Localizer["WhyUsSubtitle"]</p>
        </div>

        <div class="row">
            <div class="col-lg-3 col-md-6 mb-4">
                <div class="why-us-item p-4 border rounded bg-white text-center h-100">
                    <div class="why-us-icon mb-2"><i class="icon-flag theme" style="font-size:2rem;"></i></div>
                    <h4>@Localizer["WhyUs1Title"]</h4>
                    <p class="mb-0">@Localizer["WhyUs1Text"]</p>
                </div>
            </div>
            <div class="col-lg-3 col-md-6 mb-4">
                <div class="why-us-item p-4 border rounded bg-white text-center h-100">
                    <div class="why-us-icon mb-2"><i class="icon-briefcase theme" style="font-size:2rem;"></i></div>
                    <h4>@Localizer["WhyUs2Title"]</h4>
                    <p class="mb-0">@Localizer["WhyUs2Text"]</p>
                </div>
            </div>
            <div class="col-lg-3 col-md-6 mb-4">
                <div class="why-us-item p-4 border rounded bg-white text-center h-100">
                    <div class="why-us-icon mb-2"><i class="icon-directions theme" style="font-size:2rem;"></i></div>
                    <h4>@Localizer["WhyUs3Title"]</h4>
                    <p class="mb-0">@Localizer["WhyUs3Text"]</p>
                </div>
            </div>
            <div class="col-lg-3 col-md-6 mb-4">
                <div class="why-us-item p-4 border rounded bg-white text-center h-100">
                    <div class="why-us-icon mb-2"><i class="icon-compass theme" style="font-size:2rem;"></i></div>
                    <h4>@Localizer["WhyUs4Title"]</h4>
                    <p class="mb-0">@Localizer["WhyUs4Text"]</p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="testimonial pt-6 pb-6" style="background-image: url(/travelin/images/testimonial.png); background-size: cover; background-position: center;">
    <div class="container">
        <div class="section-title mb-5 text-center mx-auto" style="max-width:600px;">
            <h4 class="mb-1 theme">@Localizer["TestimonialLabel"]</h4>
            <h2 class="mb-1">@Localizer["TestimonialHeading"]</h2>
        </div>

        <div class="row align-items-center">
            <div class="col-lg-5 pe-4 mb-4">
                <div class="testimonial-image">
                    <img src="/travelin/images/travel1.png" alt="@Localizer["TestimonialHeading"]" class="img-fluid rounded" />
                </div>
            </div>

            <div class="col-lg-7 ps-4">
                <div class="row">
                    @{
                        var testimonials = ViewBag.Testimonials as List<Travelin.Dtos.CommentDtos.ResultCommentDto>;
                    }
                    @if (testimonials != null)
                    {
                        @foreach (var t in testimonials)
                        {
                            <div class="col-sm-6 mb-4">
                                <div class="testimonial-item1 rounded p-4 bg-white h-100 box-shadow">
                                    <div class="author-info d-flex align-items-center mb-3">
                                        <div class="author-title">
                                            <h5 class="m-0 theme">@t.NameSurname</h5>
                                            <span>
                                                @for (int i = 1; i <= 5; i++)
                                                {
                                                    <i class="fa fa-star" style="color:@(i <= t.Score ? "#f5a623" : "#d0d0d0");font-size:.75rem;"></i>
                                                }
                                            </span>
                                        </div>
                                    </div>
                                    <div class="details">
                                        <p class="m-0" style="font-size:.9rem;">
                                            <i class="fa fa-quote-left me-2 theme"></i>@(t.CommentDetail?.Length > 120 ? t.CommentDetail.Substring(0, 120) + "…" : t.CommentDetail)
                                        </p>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        var counterSection = document.querySelector('.counter-main');

        function animateCounters() {
            document.querySelectorAll('.counter-num').forEach(function (el) {
                var target = parseInt(el.getAttribute('data-target'));
                var current = 0;
                var step = Math.ceil(target / 60);
                el.textContent = '0';
                var timer = setInterval(function () {
                    current += step;
                    if (current >= target) {
                        el.textContent = target;
                        clearInterval(timer);
                    } else {
                        el.textContent = current;
                    }
                }, 25);
            });
        }

        if (counterSection) {
            var counterObserver = new IntersectionObserver(function (entries) {
                entries.forEach(function (entry) {
                    if (entry.isIntersecting) {
                        animateCounters();
                    }
                });
            }, { threshold: 0.3 });
            counterObserver.observe(counterSection);
        }

        var cards = document.querySelectorAll('.why-us-item');
        if (cards.length > 0) {
            var cardObserver = new IntersectionObserver(function (entries) {
                entries.forEach(function (entry) {
                    var card = entry.target;
                    var index = Array.from(cards).indexOf(card);
                    if (entry.isIntersecting) {
                        setTimeout(function () {
                            card.classList.add('show');
                        }, index * 150);
                    } else {
                        card.classList.remove('show');
                    }
                });
            }, { threshold: 0.2 });

            cards.forEach(function (card) {
                cardObserver.observe(card);
            });
        }
    </script>
}